# Copie ce fichier en .env et mets ta clé Together AI
TOGETHER_API_KEY=
# Modèle « serverless » (utilisable sans endpoint dédié) qui gère le JSON structuré.
# Mesuré le 21/11 (npm run bench:llm) : GLM-5.2 0,6 s · DeepSeek-V4.1-Flash 0,8 s · Qwen3.5-9B 1,0 s · GLM-5.3-Flash ignore « pas de réflexion » (réponse vide)
TOGETHER_MODEL=zai-org/GLM-5.2
# Par défaut l'agent SIMULE les actions (rien n'est fermé). Mets 0 pour agir pour de vrai (démo).
PREFLIGHT_DRY_RUN=1

# Calendrier (facultatif). Sans rien : resources/demo.ics (3 meetings recalés sur aujourd'hui).
# Lien ICS secret : Outlook > Paramètres > Calendrier > Calendriers partagés > Publier un calendrier (lien ICS)
#                   Google Agenda > Paramètres de l'agenda > Adresse secrète au format iCal
# CALENDAR_ICS_URL=https://outlook.office365.com/owa/calendar/.../calendar.ics
# CALENDAR_ICS_FILE=/Users/toi/Downloads/mon-agenda.ics

# Tri des onglets par l'IA : 0 = n'envoyer à Together que les noms de sites, pas les titres des onglets.
TABS_SEND_TITLES=1

# Une phrase sur toi, donnée à l'IA pour qu'elle sache ce qui compte comme « travail ».
USER_CONTEXT=Étudiant en informatique à l'EPFL, je développe une app Kotlin et je participe à un hackathon.

# 1 = laisser le modèle « réfléchir » avant de répondre (plus lent, et peut vider la réponse). Par défaut : coupé.
LLM_REASONING=0

# Modèle pour le tri des onglets (sinon TOGETHER_MODEL). Mesuré le 21/11 (npm run bench:llm, 25 onglets étiquetés) :
#   gpt-oss-120b : 0 erreur grave, 0 oubli, ~4 s  ← le plus juste (le tri est fait en avance, 8 min avant le meeting)
#   GLM-5.2 : 1 erreur grave (ferme Stack Overflow), 0,8 s · DeepSeek-V4.1-Flash : 1,5 · Qwen3.5-9B : 2
TOGETHER_TABS_MODEL=openai/gpt-oss-120b

# front = ne regarder (et ne fermer) que la fenêtre Chrome au premier plan. Pratique pour tester et pour la démo.
# TABS_SCOPE=front
