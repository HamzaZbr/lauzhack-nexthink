# Copy this file to .env and add your Together AI key.
TOGETHER_API_KEY=

# Serverless model (no dedicated endpoint needed) that supports structured JSON. Used for the morning brief.
# Measured on 21/11 (npm run bench:llm): GLM-5.2 0.6 s · DeepSeek-V4.1-Flash 0.8 s · Qwen3.5-9B 1.0 s
TOGETHER_MODEL=zai-org/GLM-5.2

# Model for tab triage (falls back to TOGETHER_MODEL). Measured on 25 hand-labelled tabs:
#   gpt-oss-120b: 0 serious errors, 0 misses, ~4 s  <- most accurate (triage runs 8 min before the block)
#   GLM-5.2: 1 serious error (closes Stack Overflow), 0.8 s · DeepSeek-V4.1-Flash: 1.5 · Qwen3.5-9B: 2
TOGETHER_TABS_MODEL=openai/gpt-oss-120b

# By default the agent SIMULATES actions (nothing is closed). Set to 0 to act for real.
PREFLIGHT_DRY_RUN=1

# Calendar (optional). Without either line: resources/demo.ics (demo meetings moved to today).
# Secret ICS link: Outlook > Settings > Calendar > Shared calendars > Publish a calendar (ICS link)
#                  Google Calendar > Settings for my calendar > Secret address in iCal format
# CALENDAR_ICS_URL=https://outlook.office365.com/owa/calendar/.../calendar.ics
# CALENDAR_ICS_FILE=./resources/outlook-preflight-22-23nov.ics

# One sentence about you, given to the LLM so it knows what counts as work. No "#" in the sentence.
USER_CONTEXT=Software engineer working on a web app, with a few meetings a day.

# Tab triage: 0 = send only site names to Together, not tab titles.
TABS_SEND_TITLES=1

# 1 = let the model "think" before answering (slower, and can empty the answer). Off by default.
LLM_REASONING=0

# front = only look at (and close tabs in) the front Chrome window. Handy for testing and demos.
# TABS_SCOPE=front

# At launch: Sparky alone (default). dashboard = open the dashboard and the brief instead.
# PREFLIGHT_START=dashboard

# Extra work sites, on top of the built-in list (GitHub, Stack Overflow, docs, *.epfl.ch…): never closed.
# WORK_SITES=mycompany.com,jira.example.com
