# Copie ce fichier en .env et mets ta clé Together AI
TOGETHER_API_KEY=
# Modèle « serverless » (utilisable sans endpoint dédié) qui gère le JSON structuré.
# Autres choix possibles : Qwen/Qwen3.5-9B, openai/gpt-oss-120b, zai-org/GLM-5.3
TOGETHER_MODEL=zai-org/GLM-5.3-Flash
# Par défaut l'agent SIMULE les actions (rien n'est fermé). Mets 0 pour agir pour de vrai (démo).
PREFLIGHT_DRY_RUN=1

# Calendrier (facultatif). Sans rien : resources/demo.ics (3 meetings recalés sur aujourd'hui).
# Lien ICS secret : Outlook > Paramètres > Calendrier > Calendriers partagés > Publier un calendrier (lien ICS)
#                   Google Agenda > Paramètres de l'agenda > Adresse secrète au format iCal
# CALENDAR_ICS_URL=https://outlook.office365.com/owa/calendar/.../calendar.ics
# CALENDAR_ICS_FILE=/Users/toi/Downloads/mon-agenda.ics
