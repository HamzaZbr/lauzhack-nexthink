# Copie ce fichier en .env et mets ta clé Together AI
TOGETHER_API_KEY=
# Modèle conseillé par la doc Together pour le function calling ; change-le s'il n'est pas dispo sur ta clé
TOGETHER_MODEL=zai-org/GLM-5.1
# Par défaut l'agent SIMULE les actions (rien n'est fermé). Mets 0 pour agir pour de vrai (démo).
PREFLIGHT_DRY_RUN=1
